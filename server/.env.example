# --- Server environment variables ---
# Copy to server/.env for local development, or add these as Cursor Secrets
# (they are injected as environment variables in Cloud Agents).

# Port the Express API listens on (optional, defaults to 3000)
PORT=3000

# Neon serverless Postgres connection string (REQUIRED — the server exits on
# boot without it). Format: postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# Clerk backend keys (REQUIRED — clerkMiddleware runs on every request and
# throws if these are missing).
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Google Gemini Developer API key (used for article + blog-title generation).
# Optional fallbacks: GEMINI_API_KEY_2, GOOGLE_API_KEY.
GEMINI_API_KEY=

# Pollinations API key (used for image generation).
POLLINATIONS_API_KEY=

# Cloudinary credentials (used for background/object removal).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
