# --- Client environment variables ---
# Copy to client/.env for local development, or add these as Cursor Secrets
# (Vite exposes variables prefixed with VITE_ to the browser).

# Clerk publishable key (REQUIRED — the app throws on startup without it).
VITE_CLERK_PUBLISHABLE_KEY=

# Base URL of the backend API (optional, defaults to http://localhost:3000).
VITE_API_URL=http://localhost:3000
